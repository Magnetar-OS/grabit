<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.idominikos.Grabit</id>
  <name>grabit</name>
  <summary>Selection-triggered actions for Wayland desktops</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <url type="homepage">https://github.com/Magnetar-OS/grabit</url>
  <url type="bugtracker">https://github.com/Magnetar-OS/grabit/issues</url>
  <url type="vcs-browser">https://github.com/Magnetar-OS/grabit</url>
  <launchable type="desktop-id">io.github.idominikos.Grabit.desktop</launchable>
  <provides>
    <binaries>
      <binary>grabit</binary>
    </binaries>
  </provides>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>selection</keyword>
    <keyword>clipboard</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
  <!-- Software centres show this as the "What's New" text. The marker comment
       lets release-kit rewrite the version and the date together, so it cannot
       drift from Cargo.toml: this file is listed in release.config.json's
       "versionFiles". -->
  <releases>
    <release version="1.0.2" date="2026-09-10"> <!-- x-release-kit-version-date -->
      <description>
        <ul>
          <li>First release</li>
        </ul>
      </description>
    </release>
  </releases>

  <description>
    <p>
      Select text anywhere and a small bar of actions appears over it — copy,
      search, translate, open, transform, run. Actions are one TOML file each,
      so they can be dropped in, edited or deleted.
    </p>
    <p>
      Wayland only. On cosmic-comp, KWin and wlroots compositors grabit watches
      the selection and draws the bar itself; on GNOME a companion shell
      extension does both, because Mutter exposes neither capability to clients.
    </p>
  </description>
</component>
