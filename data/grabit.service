[Unit]
Description=grabit — selection-triggered actions
Documentation=https://github.com/Magnetar-OS/grabit
# Wayland-only: without a display there is nothing to watch and nowhere to draw.
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/grabit run
ExecReload=/usr/bin/grabit reload
Restart=on-failure
RestartSec=2
# 78: this session offers grabit no way to run (for example GNOME before the
# shell extension is enabled). Restarting cannot change that.
RestartPreventExitStatus=78

[Install]
WantedBy=graphical-session.target
